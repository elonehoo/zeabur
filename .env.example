# Zeabur API Configuration for Integration Tests

# Required: Your Zeabur API token
# Get it from: https://dash.zeabur.com/account/developer
ZEABUR_TOKEN=

# Optional: GraphQL endpoint (defaults to production)
ZEABUR_ENDPOINT=https://api.zeabur.com/graphql

# Test Project Configuration
# The tests will create a dedicated test project and use it for all tests
# You can also specify an existing project ID to reuse
TEST_PROJECT_NAME=zeabur-sdk-test
# TEST_PROJECT_ID=  # Optional: use existing project instead of creating new one

# Test Configuration
CLEANUP_AFTER_TESTS=false  # Set to true to delete test project after all tests complete
